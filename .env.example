# Cổng chạy ứng dụng web và Socket.IO
PORT=3000

# Chuỗi kết nối MongoDB (Local hoặc MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/dconnect_db

# Khóa bí mật cho session cookie
SESSION_SECRET=dconnect_default_development_secret_key_change_in_production

# Môi trường chạy: development | production | test
NODE_ENV=development
